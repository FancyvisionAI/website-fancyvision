generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  SPAM
  ARCHIVED
}

enum MenuLocation {
  HEADER
  FOOTER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  status        UserStatus  @default(ACTIVE)
  roleId        String?
  role          Role?       @relation(fields: [roleId], references: [id])
  accounts      Account[]
  sessions      Session[]
  authoredPosts Article[]   @relation("ArticleAuthor")
  activity      AuditLog[]
  assignedCalls Appointment[] @relation("AssignedConsultant")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Page {
  id          String        @id @default(cuid())
  locale      String        @default("fr")
  title       String
  slug        String
  eyebrow     String?
  headline    String?
  description String?       @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  sections    Section[]
  seo         Seo?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([status, publishedAt])
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  name      String
  data      Json
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

model Seo {
  id          String  @id @default(cuid())
  pageId      String? @unique
  page        Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  serviceId   String? @unique
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  trainingId  String? @unique
  training    Training? @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  articleId   String? @unique
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  caseStudyId String? @unique
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  title       String
  description String  @db.Text
  keywords    String[]
  canonical   String?
  ogImage     String?
  schema      Json?
  noIndex     Boolean @default(false)
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id          String          @id @default(cuid())
  locale      String          @default("fr")
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  title       String
  slug        String
  excerpt     String          @db.Text
  content     Json
  icon        String?
  image       String?
  status      ContentStatus   @default(DRAFT)
  order       Int             @default(0)
  featured    Boolean         @default(false)
  publishedAt DateTime?
  seo         Seo?
  caseStudies CaseStudy[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([locale, slug])
  @@index([status, order])
}

model TrainingCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  order       Int        @default(0)
  trainings   Training[]
}

model Training {
  id           String           @id @default(cuid())
  locale       String           @default("fr")
  categoryId   String?
  category     TrainingCategory? @relation(fields: [categoryId], references: [id])
  title        String
  slug         String
  excerpt      String           @db.Text
  content      Json
  objectives   String[]
  audience     String[]
  modules      Json
  priceCents   Int?
  duration     String?
  image        String?
  pdfUrl       String?
  instructor   String?
  difficulty   Difficulty       @default(ALL_LEVELS)
  status       ContentStatus    @default(DRAFT)
  featured     Boolean          @default(false)
  order        Int              @default(0)
  publishedAt  DateTime?
  seo          Seo?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([locale, slug])
  @@index([status, order])
}

model ArticleCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  articles    Article[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id           String          @id @default(cuid())
  locale       String          @default("fr")
  categoryId   String?
  category     ArticleCategory? @relation(fields: [categoryId], references: [id])
  authorId     String?
  author       User?           @relation("ArticleAuthor", fields: [authorId], references: [id])
  title        String
  slug         String
  excerpt      String          @db.Text
  content      Json
  coverImage   String?
  status       ContentStatus   @default(DRAFT)
  readingTime  Int             @default(5)
  featured     Boolean         @default(false)
  scheduledFor DateTime?
  publishedAt  DateTime?
  tags         ArticleTag[]
  relatedFrom  ArticleRelation[] @relation("RelatedFrom")
  relatedTo    ArticleRelation[] @relation("RelatedTo")
  seo          Seo?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([locale, slug])
  @@index([status, publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleRelation {
  fromId String
  toId   String
  from   Article @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Article @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  position  String
  biography String   @db.Text
  picture   String?
  linkedin  String?
  social    Json?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseStudy {
  id          String        @id @default(cuid())
  locale      String        @default("fr")
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id])
  title       String
  slug        String
  company     String
  companyLogo String?
  sector      String?
  teamSize    Int?
  excerpt     String        @db.Text
  before      String        @db.Text
  after       String        @db.Text
  content     Json
  metrics     Json
  gallery     String[]
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  seo         Seo?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([status, publishedAt])
}

model Faq {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  position  String?
  quote     String   @db.Text
  avatar    String?
  rating    Int      @default(5)
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("fr")
  source         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model ContactRequest {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  replyStatus String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model Appointment {
  id                   String        @id @default(cuid())
  name                 String
  email                String
  phone                String?
  company              String?
  preferredDate        DateTime?
  topic                String?
  message              String?       @db.Text
  status               RequestStatus @default(NEW)
  assignedConsultantId String?
  assignedConsultant   User?         @relation("AssignedConsultant", fields: [assignedConsultantId], references: [id])
  notes                String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status, preferredDate])
}

model Event {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  description   String              @db.Text
  type          String
  audience      String
  location      String
  host          String
  startAt       DateTime
  endAt         DateTime?
  image         String?
  capacity      Int?
  status        ContentStatus       @default(DRAFT)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, startAt])
}

model EventRegistration {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  company   String?
  message   String?       @db.Text
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([eventId, email])
  @@index([eventId, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id        String       @id @default(cuid())
  name      String
  location  MenuLocation
  locale    String       @default("fr")
  items     MenuItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([location, locale])
}

model MenuItem {
  id         String     @id @default(cuid())
  menuId     String
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[] @relation("MenuChildren")
  label      String
  url        String
  external   Boolean    @default(false)
  order      Int        @default(0)
  visible    Boolean    @default(true)

  @@index([menuId, order])
}

model Media {
  id        String   @id @default(cuid())
  name      String
  url       String
  key       String?  @unique
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String
  folder    String?  @default("/")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String   @id @default(cuid())
  source    String   @unique
  target    String
  permanent Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  sessionId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, createdAt])
}
