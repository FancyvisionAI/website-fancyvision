  name text [not null]
  data jsonb [not null]
  order integer [not null, default: 0]
  visible boolean [not null, default: true]
  createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp(3) [not null, note: 'Prisma-managed @updatedAt']

  indexes {
    (pageId, order) [name: 'Section_pageId_order_idx']
  }

  Note: 'Ordered structured content blocks belonging to a page.'
}

Table Seo {
  id text [pk, not null, note: 'Prisma app default cuid()']
