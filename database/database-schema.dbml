  }

  Note: 'Ordered hierarchical navigation entries belonging to a menu.'
}

Table Media {
  id text [pk, not null, note: 'Prisma app default cuid()']
  name text [not null]
  url text [not null]
  key text [unique]
  mimeType text [not null]
  size integer [not null]
  width integer
  height integer
  alt text [not null]
  folder text [default: '/']
  createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp(3) [not null, note: 'Prisma-managed @updatedAt']

  Note: 'Metadata for uploaded media assets.'
}

