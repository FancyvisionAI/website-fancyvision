// FancyVision relational schema
// Generated from prisma/schema.prisma and prisma/migrations.
// This is documentation only; it does not modify the database.

Enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

Enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

Enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

Enum MenuLocation {
  HEADER
  FOOTER
  MOBILE
}

Enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

Table User {
  id text [pk, not null, note: 'Prisma app default cuid()']
  name text
  email text [not null, unique]
  emailVerified timestamp(3)
  image text
  passwordHash text
  status UserStatus [not null, default: 'ACTIVE']
  roleId text
  createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp(3) [not null, note: 'Prisma-managed @updatedAt']

  Note: 'Application identities, credentials linkage, status, and optional role assignment.'
}

Table Account {
  userId text [not null]
  type text [not null]
  provider text [not null]
  providerAccountId text [not null]
  refresh_token text
  access_token text
  expires_at integer
  token_type text
  scope text
  id_token text
  session_state text

  indexes {
    (provider, providerAccountId) [pk, name: 'Account_pkey']
  }

  Note: 'External authentication-provider accounts linked to users.'
}

Table Session {
  sessionToken text [pk, not null, unique]
  userId text [not null]
  expires timestamp(3) [not null]

  Note: 'Persisted authentication sessions associated with users.'
}

Table VerificationToken {
  identifier text [not null]
  token text [not null, unique]
  expires timestamp(3) [not null]

  indexes {
    (identifier, token) [pk, name: 'VerificationToken_pkey']
  }

  Note: 'Short-lived tokens used by authentication verification flows.'
}

Table Role {
  id text [pk, not null, note: 'Prisma app default cuid()']
  name text [not null, unique]
  description text
  createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp(3) [not null, note: 'Prisma-managed @updatedAt']

  Note: 'Named authorization roles assigned to users.'
}

Table Permission {
  id text [pk, not null, note: 'Prisma app default cuid()']
  key text [not null, unique]
  description text

  Note: 'Atomic authorization capabilities attached to roles.'
}

Table RolePermission {
  roleId text [not null]
  permissionId text [not null]

  indexes {
    (roleId, permissionId) [pk, name: 'RolePermission_pkey']
  }

  Note: 'Junction table implementing the many-to-many role-permission assignment.'
}

Table Page {
  id text [pk, not null, note: 'Prisma app default cuid()']
  locale text [not null, default: 'fr']
  title text [not null]
  slug text [not null]
  eyebrow text
  headline text
  description text
  status ContentStatus [not null, default: 'DRAFT']
  publishedAt timestamp(3)
  createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp(3) [not null, note: 'Prisma-managed @updatedAt']

  indexes {
    (locale, slug) [unique, name: 'Page_locale_slug_key']
    (status, publishedAt) [name: 'Page_status_publishedAt_idx']
  }

  Note: 'Localized CMS pages and their publication lifecycle.'
}

Table Section {
  id text [pk, not null, note: 'Prisma app default cuid()']
  pageId text [not null]
