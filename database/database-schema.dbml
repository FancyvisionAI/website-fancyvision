  Note: 'Optional one-to-one SEO metadata for one of several content types.'
}

Table Setting {
  id text [pk, not null, note: 'Prisma app default cuid()']
  key text [not null, unique]
  value jsonb [not null]
  group text [not null, default: 'general']
  createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp(3) [not null, note: 'Prisma-managed @updatedAt']

  Note: 'Keyed JSON configuration grouped by application area.'
}

Table Menu {
  id text [pk, not null, note: 'Prisma app default cuid()']
  name text [not null]
