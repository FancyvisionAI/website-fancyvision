# Modèle de configuration Nginx pour Sapiens-IA sur le VPS.
#
# À copier vers /etc/nginx/sites-available/sapiens-ia puis :
#   sudo ln -s /etc/nginx/sites-available/sapiens-ia /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# Remplacer your-domain.example par le domaine réel avant utilisation.
# Les chemins de certificat (ssl_certificate*) sont ceux générés
# automatiquement par Certbot (voir docs/VPS_DEPLOYMENT.md) — ne pas les
# créer à la main, ils n'existent qu'après la première émission du
# certificat.

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example www.your-domain.example;

    # Requis par Certbot pour la validation HTTP-01 avant l'émission du
    # certificat. Doit rester accessible même après bascule HTTPS (pour le
    # renouvellement automatique).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.example www.your-domain.example;

    ssl_certificate     /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/sapiens-ia.access.log;
    error_log  /var/log/nginx/sapiens-ia.error.log;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # En-têtes transmis à Next.js/Auth.js — nécessaires pour :
        # - AUTH_TRUST_HOST (Auth.js doit reconnaître le host/protocole réels)
        # - le rate-limiting par IP (lib/rate-limit.ts lit x-forwarded-for)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Websockets (HMR non utilisé en production, mais inoffensif à garder
        # si un usage futur en a besoin).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }
}
