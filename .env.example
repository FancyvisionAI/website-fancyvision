# Copy this file to .env for local development only.
# In Vercel, configure these values in Project Settings > Environment Variables.
# Use the remote connection string supplied by your managed PostgreSQL provider.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"

AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXT_PUBLIC_RASA_URL="http://localhost:5005"

# "active" affiche le chatbot Rasa (icône flottante). Toute autre valeur
# (ou absence de la variable) l'affiche en brouillon : icône WhatsApp à la
# même place, chatbot inchangé côté code/backend. Voir components/public/floating-contact.tsx.
CHATBOT_STATUS="draft"

UPLOADTHING_TOKEN=""
NEXT_PUBLIC_GA_ID=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FancyVision <contact@your-domain.example>"
# Optionnel : adresse de réception des notifications (contact, rendez-vous,
# demandes de formation, inscriptions événement). Si absente, repli sur
# SMTP_USER (comportement historique) — voir lib/email.ts.
CONTACT_NOTIFICATION_EMAIL=""

# Local Docker Compose database settings. Never use these placeholders in production.
POSTGRES_DB="fancyvision"
POSTGRES_USER="fancyvision"
POSTGRES_PASSWORD="replace-with-a-local-development-password"

# Used only by the local seed script to create the first administrator.
ADMIN_PASSWORD="replace-with-a-local-development-admin-password"
